# Puertos locales (pueden ser modificados por el instalador en caso de conflicto)
SERVER_PORT=3000
WEB_PORT=8080
DB_PORT=5432

# Base de datos (Postpuesta para el futuro, pero aquí estará)
DATABASE_URL=postgresql://openfactu:openfactu_pass@localhost:5432/openfactudb

# Container de PostgreSQL para pg_dump/psql (nombre del container Docker, NO un host).
# Vacío = autodetección del container de postgres en ejecución.
OPENFACTU_PG_CONTAINER=platform-db-1

# ── Seguridad ──
JWT_SECRET=super-secret-key
