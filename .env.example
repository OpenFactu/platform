# Puertos locales (pueden ser modificados por el instalador en caso de conflicto)
SERVER_PORT=3000
WEB_PORT=8080
DB_PORT=5432

# ── Exposición en red ──
# Desde dónde se aceptan conexiones a Postgres y al ERP. 127.0.0.1 = solo esta
# máquina (recomendado: desde fuera se entra por la web).
BIND_ADDR=127.0.0.1
# Interfaz de la web. Con HTTPS (docker compose --profile https) pon 127.0.0.1
# para que solo se entre por Caddy.
WEB_BIND=0.0.0.0
# Dominio público para el certificado automático del profile `https`.
KEIROST_DOMAIN=

# Base de datos (Postpuesta para el futuro, pero aquí estará)
DATABASE_URL=postgresql://openfactu:openfactu_pass@localhost:5432/openfactudb

# ── Monitoreo ──
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@openfactu.com
PGADMIN_PASSWORD=admin

GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3001

PROMETHEUS_PORT=9090
LOKI_PORT=3100
CADVISOR_PORT=8081
NODE_EXPORTER_PORT=9100
PORTAINER_PORT=9000

# Nombre del container Docker de PostgreSQL para pg_dump/psql (NO un host).
# Déjalo vacío para autodetectar el container de postgres en ejecución
# (recomendado en desarrollo local, p.ej. "<carpeta>-db-1").
OPENFACTU_PG_CONTAINER=

# ── Seguridad ──
# Secreto para firmar los JWT. CAMBIAR en producción por un valor largo y aleatorio.
JWT_SECRET=super-secret-key
# Clave de cifrado para los secretos TOTP (2FA) en reposo. 32 bytes en hex (64 chars).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENC_KEY=
# Clave de cifrado para secretos de configuración (tokens de Google/OneDrive, etc.).
# Mismo formato que TOTP_ENC_KEY. Si se deja vacía se deriva del JWT_SECRET (solo dev).
CONFIG_ENC_KEY=

# ── Mensajería (apps/messaging, servicio Rust) ──
# Secreto con el que el ERP firma los tickets de acceso a la mensajería y con el
# que el servicio los verifica. Distinto de JWT_SECRET: el servicio nunca lo ve.
# Obligatorio en producción; vacío en desarrollo usa uno fijo de desarrollo.
MESSAGING_TICKET_SECRET=
# Clave maestra del cifrado de mensajes (64 caracteres hex; obligatoria en
# producción). Protege la clave de cada empresa. SI SE PIERDE, SE PIERDEN LOS
# MENSAJES: guárdala fuera del servidor. Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MESSAGING_DATA_KEY=
MESSAGING_PORT=3100
# Dónde encuentra la mensajería la API del ERP (para guardar y leer los ficheros
# que entran y salen por Telegram). En Docker: http://server:3000.
MESSAGING_ERP_URL=http://localhost:3000

# ── Videollamadas (ver docs/videollamadas.md) ──
# Puerto UDP único de audio y vídeo. Hay que abrirlo en el cortafuegos.
MESSAGING_RTC_PORT=3478
# IP que se anuncia a los navegadores. Vacía: la de la red local, que vale dentro
# de la oficina y sin Docker. Con Docker o desde internet, obligatoria.
MESSAGING_RTC_PUBLIC_IP=
# Máximo de personas por llamada.
MESSAGING_RTC_MAX_PEERS=15
# TURN opcional, para redes que bloquean UDP (docker compose --profile turn).
# Ej.: turn:erp.tuempresa.com:3479?transport=udp
MESSAGING_TURN_URL=
MESSAGING_TURN_SECRET=

# ── Copias de seguridad ──
# Clave con la que se cifran las copias (64 caracteres hex, mismo comando). Sin
# ella las copias salen sin cifrar y se avisa. SI SE PIERDE, LAS COPIAS NO SE
# PUEDEN RESTAURAR: guárdala fuera del servidor y fuera de las propias copias.
BACKUP_ENC_KEY=
# Dónde encuentra el ERP la mensajería para meter los mensajes en las copias.
# En Docker: http://messaging:3100.
MESSAGING_URL=http://localhost:3100

# ── Integraciones cloud (Google Drive / OneDrive) ──
# App OAuth global: permite a cualquier tenant conectar su cuenta con un clic.
# Google: crear en https://console.cloud.google.com (OAuth client, tipo Web).
# Microsoft: crear en https://portal.azure.com (App registration, plataforma Web).
# Cada tenant puede alternativamente usar credenciales propias desde Ajustes.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
# URL pública base para los redirect_uri de OAuth (sin barra final).
# En dev con Vite: http://localhost:8080 · en prod: https://tudominio.com
# El redirect_uri registrado debe ser <base>/api/config/storage/oauth/<provider>/callback
OAUTH_REDIRECT_BASE_URL=

# ── IA ──
# Fallback global opcional para el proveedor de IA; lo normal es configurar la
# key por tenant en Ajustes → Empresa → IA.
AI_API_KEY=
# Puerto del Ollama local (profile "ai" del docker-compose, o instalación nativa).
OLLAMA_PORT=11434

# Mapas: servidor de teselas. Sin esto se usa OpenStreetMap, que no admite tráfico de producción.
# VITE_MAP_TILE_URL=https://tiles.ejemplo.com/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=© OpenStreetMap
