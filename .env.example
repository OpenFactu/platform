# Puertos locales (pueden ser modificados por el instalador en caso de conflicto)
SERVER_PORT=3000
WEB_PORT=8080
DB_PORT=5432

# Base de datos (Postpuesta para el futuro, pero aquí estará)
DATABASE_URL=postgresql://openfactu:openfactu_pass@localhost:5432/openfactudb

# ── Monitoreo ──
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@openfactu.com
PGADMIN_PASSWORD=admin

GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3001

PROMETHEUS_PORT=9090
LOKI_PORT=3100
CADVISOR_PORT=8081
NODE_EXPORTER_PORT=9100
PORTAINER_PORT=9000

# Nombre del container Docker de PostgreSQL para pg_dump/psql (NO un host).
# Déjalo vacío para autodetectar el container de postgres en ejecución
# (recomendado en desarrollo local, p.ej. "<carpeta>-db-1").
OPENFACTU_PG_CONTAINER=

# ── Seguridad ──
# Secreto para firmar los JWT. CAMBIAR en producción por un valor largo y aleatorio.
JWT_SECRET=super-secret-key
# Clave de cifrado para los secretos TOTP (2FA) en reposo. 32 bytes en hex (64 chars).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENC_KEY=

# ── IA ──
# Fallback global opcional para el proveedor de IA; lo normal es configurar la
# key por tenant en Ajustes → Empresa → IA.
AI_API_KEY=
# Puerto del Ollama local (profile "ai" del docker-compose, o instalación nativa).
OLLAMA_PORT=11434
