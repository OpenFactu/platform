{
  "name": "@openfactu/server",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --watch ../../node_modules/@openfactu/pdf/dist,../../node_modules/@openfactu/common/dist,../../node_modules/@openfactu/site-builder/dist src/server.ts",
    "build": "tsc --noEmit && tsc && npm run copy-assets",
    "copy-assets": "node scripts/copy-assets.mjs",
    "start": "node dist/server.js",
    "sync": "ts-node src/scripts/sync-all-tenants.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:push:public": "ts-node src/scripts/push-public.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.16",
    "@ai-sdk/google": "^4.0.18",
    "@ai-sdk/openai": "^4.0.16",
    "@ai-sdk/openai-compatible": "^3.0.12",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openfactu/common": "^0.2.1",
    "@openfactu/pdf": "^0.2.0",
    "@openfactu/site-builder": "^0.1.0",
    "@types/adm-zip": "^0.5.8",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^6.4.23",
    "@types/pdf-parse": "^1.1.5",
    "adm-zip": "^0.5.17",
    "ai": "^7.0.31",
    "bcrypt": "^6.0.0",
    "bwip-js": "^4.9.2",
    "chokidar": "^5.0.0",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "nodemailer": "^6.10.1",
    "otplib": "^12.0.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "prom-client": "^15.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "ws": "^8.20.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
